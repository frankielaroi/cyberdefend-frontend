# CyberDefend 360 Frontend - Production Configuration

# Production API Configuration
VITE_API_BASE_URL=https://api.cyberdefend360.com/api/v1

# Real-time Configuration
VITE_POLLING_INTERVAL=30000
VITE_ALERT_POLLING_INTERVAL=30000
VITE_STATS_POLLING_INTERVAL=60000

# Feature Flags
VITE_ENABLE_REAL_TIME_ALERTS=true
VITE_ENABLE_REAL_TIME_STATS=true
VITE_ENABLE_DEBUG_LOGGING=false

# Security Configuration
VITE_TOKEN_REFRESH_THRESHOLD=300000
VITE_MAX_RETRY_ATTEMPTS=3
VITE_REQUEST_TIMEOUT=30000

# Application Environment
VITE_APP_ENV=production
VITE_APP_NAME=CyberDefend 360
VITE_APP_VERSION=1.0.0

# Analytics & Monitoring
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false

# File Upload Limits
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx

# UI Configuration
VITE_DEFAULT_LANGUAGE=en
VITE_DEFAULT_THEME=light
VITE_ITEMS_PER_PAGE=25

# External Services (if needed)
VITE_STRIPE_PUBLIC_KEY=
VITE_RECAPTCHA_SITE_KEY=