# CyberDefend 360 Frontend Environment Variables

# API Configuration
VITE_API_URL=http://localhost:3000/api/v1
VITE_API_TIMEOUT=30000

# Application Environment
VITE_APP_ENV=development
VITE_APP_NAME=CyberDefend 360
VITE_APP_VERSION=1.0.0

# Authentication
VITE_JWT_EXPIRY=3600
VITE_REFRESH_TOKEN_EXPIRY=86400

# Feature Flags
VITE_FEATURE_DEFENDX_PLUS=true
VITE_FEATURE_ADMIN_PANEL=true
VITE_FEATURE_BILLING=true

# Analytics & Monitoring
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false

# File Upload Limits
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx

# UI Configuration
VITE_DEFAULT_LANGUAGE=en
VITE_DEFAULT_THEME=light
VITE_ITEMS_PER_PAGE=25

# External Services (if needed)
VITE_STRIPE_PUBLIC_KEY=
VITE_RECAPTCHA_SITE_KEY=